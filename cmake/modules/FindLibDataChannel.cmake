#
# This module defines the following variables:
#
#  LIBDATACHANNEL_FOUND - libdatachannel was found
#  LIBDATACHANNEL_INCLUDE_DIRS - libdatachannel include directories
#  LIBDATACHANNEL_LIBRARIES - libdatachannel libraries to link
#
# This module also creates the following imported target:
#
#  LibDataChannel::LibDataChannel - imported target wrapping the include dirs
#  and libraries so consumers only need to link the namespace target.
#
# Hint variables:
#  LIBDATACHANNEL_PATH     - root path to a libdatachannel install
#  LIBDATACHANNEL_PATH64   - root path to a 64-bit libdatachannel install
#
# Environment variables:
#  LIBDATACHANNEL_PATH     - root path to a libdatachannel install
#  LIBDATACHANNEL_PATH64   - root path to a 64-bit libdatachannel install
#
# Discovery order:
#  1. pkg_check_modules (libdatachannel) when pkg-config is available
#  2. find_path / find_library with hints from PKG and env vars
#  3. The imported target is created last so all discovery methods feed it

find_package(PkgConfig QUIET)

if(CMAKE_SIZEOF_VOID_P EQUAL 8)
	set(_lib_suffix 64)
else()
	set(_lib_suffix 32)
endif()

# ---------------------------------------------------------------------------
# pkg-config discovery (primary hint source)
# ---------------------------------------------------------------------------
if(PKG_CONFIG_FOUND)
	pkg_check_modules(PC_LIBDATACHANNEL QUIET libdatachannel)
endif()

# ---------------------------------------------------------------------------
# Include directory discovery
# ---------------------------------------------------------------------------
find_path(LIBDATACHANNEL_INCLUDE_DIR
	NAMES
		"rtc/rtc.hpp"
	HINTS
		ENV LIBDATACHANNEL_PATH
		ENV LIBDATACHANNEL_PATH64
		${LIBDATACHANNEL_PATH}
		${LIBDATACHANNEL_PATH64}
		${PC_LIBDATACHANNEL_INCLUDE_DIRS}
	PATHS
		/usr/include
		/usr/local/include
		/opt/local/include
		/sw/include
	PATH_SUFFIXES
		include
)

# ---------------------------------------------------------------------------
# Library discovery
# ---------------------------------------------------------------------------
# On MSVC debug builds, libdatachannel's import library is named with a 'd'
# suffix (datachanneld.lib) per the ConanCenter and vcpkg packaging. Include
# both release and debug variants so find_library succeeds in all configs.
if(WIN32)
	set(CMAKE_FIND_LIBRARY_SUFFIXES ".lib")
	set(_ldc_lib_names "libdatachannel" "datachannel" "datachanneld" "libdatachanneld")
else()
	set(_ldc_lib_names "libdatachannel" "datachannel")
endif()
find_library(LIBDATACHANNEL_LIBRARY
	NAMES
		${_ldc_lib_names}
	HINTS
		ENV LIBDATACHANNEL_PATH
		ENV LIBDATACHANNEL_PATH64
		${LIBDATACHANNEL_PATH}
		${LIBDATACHANNEL_PATH64}
		${PC_LIBDATACHANNEL_LIBRARY_DIRS}
	PATHS
		/usr/lib
		/usr/local/lib
		/opt/local/lib
		/sw/lib
	PATH_SUFFIXES
		lib${_lib_suffix} lib
		libs${_lib_suffix} libs
		bin${_lib_suffix} bin
)

# Try to find the shared binary location on Windows so downstream packaging
# can distribute the correct DLL alongside the plugin. Debug builds produce
# datachanneld.dll.
if(WIN32)
	set(_ldc_bin_names "libdatachannel" "datachannel" "datachanneld" "libdatachanneld")
	set(CMAKE_FIND_LIBRARY_SUFFIXES ".dll")
	find_library(LIBDATACHANNEL_BINARY
		NAMES
			${_ldc_bin_names}
		HINTS
			ENV LIBDATACHANNEL_PATH
			ENV LIBDATACHANNEL_PATH64
			${LIBDATACHANNEL_PATH}
			${LIBDATACHANNEL_PATH64}
			${PC_LIBDATACHANNEL_LIBRARY_DIRS}
		PATH_SUFFIXES
			bin${_lib_suffix} bin
			lib${_lib_suffix} lib
	)
endif()

# ---------------------------------------------------------------------------
# Validation
# ---------------------------------------------------------------------------
include(FindPackageHandleStandardArgs)
find_package_handle_standard_args(LibDataChannel
	FOUND_VAR LIBDATACHANNEL_FOUND
	REQUIRED_VARS LIBDATACHANNEL_LIBRARY LIBDATACHANNEL_INCLUDE_DIR
)

if(LIBDATACHANNEL_FOUND)
	set(LIBDATACHANNEL_INCLUDE_DIRS ${LIBDATACHANNEL_INCLUDE_DIR})
	set(LIBDATACHANNEL_LIBRARIES ${LIBDATACHANNEL_LIBRARY})

	# Build a reusable IMPORTED target so consumers only need to
	# target_link_libraries(Target LibDataChannel::LibDataChannel).
	if(NOT TARGET LibDataChannel::LibDataChannel)
		add_library(LibDataChannel::LibDataChannel UNKNOWN IMPORTED)
		set_target_properties(LibDataChannel::LibDataChannel PROPERTIES
			INTERFACE_INCLUDE_DIRECTORIES "${LIBDATACHANNEL_INCLUDE_DIRS}"
		)
		if(EXISTS "${LIBDATACHANNEL_LIBRARY}")
			set_target_properties(LibDataChannel::LibDataChannel PROPERTIES
				IMPORTED_LOCATION "${LIBDATACHANNEL_LIBRARY}"
			)
		else()
			set_property(TARGET LibDataChannel::LibDataChannel APPEND PROPERTY
				INTERFACE_LINK_LIBRARIES "${LIBDATACHANNEL_LIBRARY}"
			)
		endif()
		mark_as_advanced(LIBDATACHANNEL_INCLUDE_DIRS LIBDATACHANNEL_LIBRARIES)
	endif()

	if(LIBDATACHANNEL_BINARY AND NOT TARGET LibDataChannel::LibDataChannel_Binary)
		add_library(LibDataChannel::LibDataChannel_Binary UNKNOWN IMPORTED)
		set_target_properties(LibDataChannel::LibDataChannel_Binary PROPERTIES
			IMPORTED_LOCATION "${LIBDATACHANNEL_BINARY}"
		)
		mark_as_advanced(LIBDATACHANNEL_BINARY)
	endif()
endif()

mark_as_advanced(LIBDATACHANNEL_INCLUDE_DIR LIBDATACHANNEL_LIBRARY)
