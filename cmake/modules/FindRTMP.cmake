#
# This module defines the following variables:
#
#  RTMP_FOUND - librtmp was found
#  RTMP_VERSION_STRING - version of librtmp found
#  RTMP_INCLUDE_DIRS - librtmp include directories
#  RTMP_LIBRARIES - librtmp libraries to link
#
# This module also creates the following imported target:
#
#  RTMP::RTMP - imported target wrapping the include dirs
#  and libraries so consumers only need to link the namespace target.
#
# Hint variables:
#  RTMP_DIR     - root path to a librtmp install (contains include/ and lib/)
#  RTMP_PATH     - root path to a librtmp install
#  RTMP_PATH64   - root path to a 64-bit librtmp install
#
# Environment variables:
#  RTMP_PATH     - root path to a librtmp install
#  RTMP_PATH64   - root path to a 64-bit librtmp install
#
# Discovery order:
#  1. pkg_check_modules (librtmp) when pkg-config is available
#  2. find_path / find_library with hints from PKG and env vars
#  3. The imported target is created last so all discovery methods feed it
#

find_package(PkgConfig QUIET)

if(CMAKE_SIZEOF_VOID_P EQUAL 8)
	set(_lib_suffix 64)
else()
	set(_lib_suffix 32)
endif()

# ---------------------------------------------------------------------------
# pkg-config discovery (primary hint source)
# ---------------------------------------------------------------------------
if(PKG_CONFIG_FOUND)
	pkg_check_modules(PC_LIBRTMP QUIET librtmp rtmpdump)
endif()

# ---------------------------------------------------------------------------
# Include directory discovery
# ---------------------------------------------------------------------------
find_path(RTMP_INCLUDE_DIR
	NAMES
		"librtmp/rtmp.h"
		"rtmp.h"
	HINTS
		ENV RTMP_PATH
		ENV RTMP_PATH64
		${RTMP_DIR}
		${PC_LIBRTMP_INCLUDE_DIRS}
	PATHS
		/usr/include
		/usr/local/include
		/opt/local/include
		/sw/include
	PATH_SUFFIXES
		include
)

# ---------------------------------------------------------------------------
# Library discovery
# ---------------------------------------------------------------------------
# On MSVC debug builds, librtmp's import library may be named with a 'd'
# suffix (rtmpd.lib). Include both release and debug variants so
# find_library succeeds in all configs.
if(WIN32)
	set(CMAKE_FIND_LIBRARY_SUFFIXES ".lib")
	set(_rtmp_lib_names "rtmp" "librtmp" "rtmpd" "librtmpd")
else()
	set(_rtmp_lib_names "rtmp" "librtmp")
endif()
find_library(RTMP_LIBRARY
	NAMES
		${_rtmp_lib_names}
	HINTS
		ENV RTMP_PATH
		ENV RTMP_PATH64
		${RTMP_DIR}
		${PC_LIBRTMP_LIBRARY_DIRS}
	PATHS
		/usr/lib
		/usr/local/lib
		/opt/local/lib
		/sw/lib
	PATH_SUFFIXES
		lib${_lib_suffix} lib
		libs${_lib_suffix} libs
		bin${_lib_suffix} bin
)

# ---------------------------------------------------------------------------
# Version extraction
# ---------------------------------------------------------------------------
if(PC_LIBRTMP_FOUND)
	set(RTMP_VERSION_STRING "${PC_LIBRTMP_VERSION}")
elseif(RTMp_LIBRARY AND RTMP_INCLUDE_DIR)
	# Try to extract the version from librtmp.h if pkg-config didn't provide it
	if(EXISTS "${RTMP_INCLUDE_DIR}/librtmp/rtmp.h")
		file(STRINGS "${RTMP_INCLUDE_DIR}/librtmp/rtmp.h" _rtmp_version_line
			REGEX "^#define[ \t]+LIBRTMP_VERSION_(STRING|MAJOR|MINOR|PATCH)")
		if(_rtmp_version_line)
			string(REPLACE "\n" ";" _rtmp_version_line "${_rtmp_version_line}")
			foreach(_line ${_rtmp_version_line})
				if(_line MATCHES "^#define[ \t]+LIBRTMP_VERSION_STRING[ \t]+\"([^\"]+)\"")
					set(RTMP_VERSION_STRING "${CMAKE_MATCH_1}")
				endif()
			endforeach()
		endif()
	endif()
endif()

# ---------------------------------------------------------------------------
# Validation
# ---------------------------------------------------------------------------
include(FindPackageHandleStandardArgs)
find_package_handle_standard_args(RTMP
	FOUND_VAR RTMP_FOUND
	REQUIRED_VARS RTMP_LIBRARY RTMP_INCLUDE_DIR
	VERSION_VAR RTMP_VERSION_STRING
)

if(RTMP_FOUND)
	# Normalize include directories: strip any trailing path components
	# that find_path may have appended (e.g. the rtmp.h directory itself).
	get_filename_component(RTMP_INCLUDE_DIRS "${RTMP_INCLUDE_DIR}" ABSOLUTE)
	if(NOT EXISTS "${RTMP_INCLUDE_DIRS}/librtmp/rtmp.h"
		AND EXISTS "${RTMP_INCLUDE_DIRS}/rtmp.h")
		set(RTMP_INCLUDE_DIRS "${RTMP_INCLUDE_DIRS}")
	endif()

	set(RTMP_LIBRARIES ${RTMP_LIBRARY})

	# Also include any extra linker dependencies reported by pkg-config
	# (e.g. pthread, dl) so the imported target links completely.
	if(PC_LIBRTMP_LINK_LIBRARIES)
		set(RTMP_LIBRARIES ${RTMP_LIBRARY} ${PC_LIBRTMP_LINK_LIBRARIES})
	endif()

	# Build a reusable IMPORTED target so consumers only need to
	# target_link_libraries(Target RTMP::RTMP).
	if(NOT TARGET RTMP::RTMP)
		add_library(RTMP::RTMP UNKNOWN IMPORTED)
		set_target_properties(RTMP::RTMP PROPERTIES
			INTERFACE_INCLUDE_DIRECTORIES "${RTMP_INCLUDE_DIRS}"
		)
		if(EXISTS "${RTMP_LIBRARY}")
			set_target_properties(RTMP::RTMP PROPERTIES
				IMPORTED_LOCATION "${RTMP_LIBRARY}"
			)
		else()
			set_property(TARGET RTMP::RTMP APPEND PROPERTY
				INTERFACE_LINK_LIBRARIES "${RTMP_LIBRARY}"
			)
		endif()
		# Propagate pkg-config-supplied linker flags (e.g. -lpthread)
		if(PC_LIBRTMP_LINK_LIBRARIES)
			set_property(TARGET RTMP::RTMP APPEND PROPERTY
				INTERFACE_LINK_LIBRARIES ${PC_LIBRTMP_LINK_LIBRARIES}
			)
		endif()
		mark_as_advanced(RTMP_INCLUDE_DIRS RTMP_LIBRARIES)
	endif()

	if(RTMP_VERSION_STRING)
		message(STATUS "librtmp ${RTMP_VERSION_STRING} found: ${RTMP_LIBRARY}")
	endif()
else()
	set(RTMP_INCLUDE_DIRS "")
	set(RTMP_LIBRARIES "")
endif()

mark_as_advanced(RTMP_INCLUDE_DIR RTMP_LIBRARY)
